---
import MainLayout from '../../../layouts/MainLayout.astro';
import { essayCollections, getEssayEditorial } from '../../../data/essayEditorial';
import { createServerClient } from '../../../lib/supabase';

const { slug } = Astro.params;
const supabase = createServerClient();

const { data: doc } = await supabase
  .from('documents')
  .select('*')
  .eq('slug', slug)
  .eq('status', 'published')
  .single();

if (!doc) {
  return Astro.redirect('/');
}

const fileType = (doc.file_type || '').toString();
const isHtml = /html/i.test(fileType);
const isPdf = /pdf/i.test(fileType);
const isImage = /image/i.test(fileType);
const hasFile = Boolean(doc.file_path);
const isSlideshow = /slideshow/i.test(fileType);
// For slideshows, file_path is a JSON manifest — only offer a download when a
// real source file (e.g. the generated PDF) exists.
const hasDownload = isSlideshow ? Boolean(doc.source_file_path) : hasFile;
const downloadPath = doc.source_file_path || doc.file_path;
const downloadType = doc.source_file_type || doc.file_type;

// Public URL for download / iframe embedding.
let fileUrl = '';
if (hasFile) {
  const { data: urlData } = supabase.storage.from('documents').getPublicUrl(doc.file_path);
  fileUrl = urlData.publicUrl;
}

let downloadUrl = fileUrl;
if (downloadPath) {
  const { data: downloadUrlData } = supabase.storage.from('documents').getPublicUrl(downloadPath);
  downloadUrl = downloadUrlData.publicUrl;
}

// Supabase serves stored HTML as text/plain, so an <iframe src> shows raw
// source. Instead we download the file server-side, strip its TextEdit/Word
// inline styling, and render the semantic markup as themed prose.
function normalizeText(value: string): string {
  return value
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;|&#160;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;|&#34;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/[^a-z0-9]+/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

function cleanExcerpt(value: string | null, title: string): string {
  if (!value) return '';
  const escapedTitle = title
    .trim()
    .split(/\s+/)
    .map((word: string) => word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    .join('\\s+');
  return value
    .trim()
    .replace(new RegExp(`^${escapedTitle}\\s*[:—–-]?\\s*`, 'i'), '')
    .replace(/^INTRO\b\s*[:—–-]?\s*/i, '')
    .trim();
}

function formatArchiveDate(value: string | null): string {
  if (!value) return '';
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(value));
}

function extractProse(html: string, title: string): string {
  const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
  let inner = bodyMatch ? bodyMatch[1] : html;
  inner = inner
    .replace(/<style[\s\S]*?<\/style>/gi, '')
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    .replace(/<meta[^>]*>/gi, '')
    .replace(/<title[\s\S]*?<\/title>/gi, '')
    .replace(/\sclass="[^"]*"/gi, '')
    .replace(/\sstyle="[^"]*"/gi, '')
    .trim();

  // Word documents often repeat their title as the first paragraph. The page
  // already provides a proper article masthead, so remove exact repetitions.
  const firstBlock = inner.match(/^\s*<(p|h[1-6])\b[^>]*>([\s\S]*?)<\/\1>/i);
  if (firstBlock && normalizeText(firstBlock[2]) === normalizeText(title)) {
    inner = inner.slice(firstBlock[0].length).trim();
  }

  return inner;
}

let proseHtml = '';
if (isHtml && hasFile) {
  const { data: blob } = await supabase.storage.from('documents').download(doc.file_path);
  if (blob) {
    proseHtml = extractProse(await blob.text(), doc.title);
  }
}

const proseText = proseHtml.replace(/<[^>]+>/g, ' ').replace(/&[^;]+;/g, ' ').replace(/\s+/g, ' ').trim();
const wordCount = proseText ? proseText.split(' ').length : 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 225));
const isEssayReader = isHtml && Boolean(proseHtml);
const currentEditorial = getEssayEditorial(doc.slug);
const displayExcerpt = currentEditorial.deck || cleanExcerpt(doc.excerpt, doc.title);
const sourceModifiedLabel = formatArchiveDate(doc.source_modified_at);

let previousEssay = null;
let nextEssay = null;
let relatedEssays = [];

if (isEssayReader) {
  const { data: essayData } = await supabase
    .from('documents')
    .select('slug,title,excerpt,date,year,tags,pages,file_type')
    .eq('status', 'published')
    .eq('category', 'Essay');

  const availableEssays = (essayData || [])
    .map((essay) => ({ ...essay, editorial: getEssayEditorial(essay.slug) }))
    .sort((a, b) => a.title.localeCompare(b.title));
  const currentIndex = availableEssays.findIndex((essay) => essay.slug === doc.slug);
  previousEssay = currentIndex > 0 ? availableEssays[currentIndex - 1] : null;
  nextEssay = currentIndex >= 0 && currentIndex < availableEssays.length - 1
    ? availableEssays[currentIndex + 1]
    : null;

  const currentTags = new Set((doc.tags || []).map((tag: string) => tag.toLowerCase()));
  const currentCollections = new Set(currentEditorial.collections);
  relatedEssays = availableEssays
    .filter((essay) => essay.slug !== doc.slug)
    .map((essay) => {
      const sharedCollections = essay.editorial.collections.filter((collection) => currentCollections.has(collection)).length;
      const sharedTags = (essay.tags || []).filter((tag: string) => currentTags.has(tag.toLowerCase())).length;
      return { ...essay, relevance: sharedCollections * 4 + sharedTags * 2 + (/html/i.test(essay.file_type || '') ? 1 : 0) };
    })
    .filter((essay) => essay.relevance > 1)
    .sort((a, b) => b.relevance - a.relevance || a.title.localeCompare(b.title))
    .slice(0, 3);
}

// Slideshows store a JSON manifest (list of slide image URLs) at file_path.
// We fetch it server-side and render a themed image gallery.
let slides: string[] = [];
if (isSlideshow && hasFile) {
  const { data: blob } = await supabase.storage.from('documents').download(doc.file_path);
  if (blob) {
    try {
      const parsed = JSON.parse(await blob.text());
      slides = Array.isArray(parsed) ? parsed : parsed.slides || [];
    } catch {
      slides = [];
    }
  }
}
---

<MainLayout title={`${doc.title} - Dr. James Landreth`}>
  <div class:list={["mx-auto px-6 py-10 sm:py-12", isEssayReader ? "max-w-5xl" : "max-w-6xl"]}>
    <div class:list={["flex flex-col items-stretch justify-between gap-3 sm:flex-row sm:items-center", isEssayReader ? "mb-10" : "mb-8"]}>
      <a
        href={isEssayReader ? '/essays' : '/'}
        class="inline-flex min-h-11 items-center justify-center gap-2 border border-rule px-4 py-2 font-mono text-[12px] tracking-[0.12em] uppercase text-ink transition-[border-color,color,scale] duration-150 hover:border-stamp hover:text-stamp active:scale-[0.96]"
      >
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        {isEssayReader ? 'All Essays' : 'Back to Archive'}
      </a>
      {hasDownload && (
        <a
          href={downloadUrl}
          download
          class="inline-flex min-h-11 items-center justify-center gap-2 border border-rule px-4 py-2 font-mono text-[12px] tracking-[0.12em] uppercase text-ink transition-[border-color,color,scale] duration-150 hover:border-stamp hover:text-stamp active:scale-[0.96]"
        >
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4-4 4m0 0-4-4m4 4V4" /></svg>
          Download {isEssayReader ? `original ${downloadType}` : ''}
        </a>
      )}
    </div>

    {isEssayReader && (
      <header class="mx-auto mb-8 max-w-3xl text-center sm:mb-10">
        <p class="mb-4 font-mono text-[11px] tracking-[0.2em] uppercase text-stamp">{doc.category} · The Reading Room</p>
        <h1 class="text-balance font-display text-4xl leading-tight text-ink sm:text-5xl">{doc.title}</h1>
        {displayExcerpt && <p class="mx-auto mt-5 line-clamp-4 max-w-2xl text-pretty font-serif text-lg leading-relaxed text-ink-muted sm:line-clamp-none">{displayExcerpt}</p>}
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-mono text-[11px] tracking-[0.12em] uppercase text-rule">
          {doc.date && <span>{doc.date}</span>}
          {doc.date && <span aria-hidden="true">·</span>}
          <span>{readingMinutes} min read</span>
          {doc.pages && <span aria-hidden="true">·</span>}
          {doc.pages && <span>{doc.pages}</span>}
        </div>
        {doc.tags && doc.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            {doc.tags.map((tag: string) => <span class="border border-rule px-2 py-1 font-mono text-[10px] tracking-[0.11em] uppercase text-rule">{tag}</span>)}
          </div>
        )}
      </header>
    )}

    {isEssayReader && (
      <section class="mb-8 bg-parchment-dark/55 p-5 shadow-[0_0_0_1px_rgba(28,35,64,0.06)] sm:mb-10 sm:p-6" aria-labelledby="archive-details-title">
        <div class="flex flex-col justify-between gap-2 border-b border-rule pb-4 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-[10px] tracking-[0.17em] uppercase text-stamp">Document provenance</p>
            <h2 id="archive-details-title" class="mt-1 font-display text-xl text-ink">About this archive copy</h2>
          </div>
          {hasDownload && <a href={downloadUrl} download class="font-mono text-[10px] tracking-[0.12em] uppercase text-stamp underline decoration-rule underline-offset-4 transition-colors duration-150 hover:text-stamp-hover">View the preserved original</a>}
        </div>
        <dl class="grid gap-5 pt-5 sm:grid-cols-3">
          <div>
            <dt class="font-mono text-[9px] tracking-[0.14em] uppercase text-rule">Document type</dt>
            <dd class="mt-2 text-pretty font-serif text-sm leading-relaxed text-ink">{currentEditorial.documentKind}</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] tracking-[0.14em] uppercase text-rule">Credit</dt>
            <dd class="mt-2 text-pretty font-serif text-sm leading-relaxed text-ink">{currentEditorial.credit}</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] tracking-[0.14em] uppercase text-rule">Preserved source</dt>
            <dd class="mt-2 text-pretty font-serif text-sm leading-relaxed text-ink">
              {doc.source_file_type || doc.file_type}{sourceModifiedLabel ? ` · source file last modified ${sourceModifiedLabel}` : ''}
            </dd>
          </div>
        </dl>
        {currentEditorial.sourceNote && <p class="mt-5 border-t border-rule pt-4 text-pretty font-serif text-xs italic leading-relaxed text-ink-muted">{currentEditorial.sourceNote}</p>}
      </section>
    )}

    <div class:list={[isEssayReader ? "block" : "grid grid-cols-1 gap-6 lg:grid-cols-[300px_1fr]"]}>
      {!isEssayReader && (
        <aside class="h-fit border border-rule bg-card p-7 lg:sticky lg:top-28">
          <div class="mb-6">
            <p class="mb-3 font-mono text-[12px] tracking-[0.14em] uppercase text-stamp">{doc.category}</p>
            <h1 class="text-balance font-display text-2xl leading-snug text-ink">{doc.title}</h1>
          </div>
          <div class="mb-5 flex flex-col gap-3 border-b border-rule pb-5">
            {doc.date && <div class="flex items-baseline justify-between gap-4 text-sm"><span class="font-mono text-[12px] tracking-[0.1em] uppercase text-rule">Date</span><span class="text-right font-serif text-ink-muted">{doc.date}</span></div>}
            {doc.location && <div class="flex items-baseline justify-between gap-4 text-sm"><span class="font-mono text-[12px] tracking-[0.1em] uppercase text-rule">Location</span><span class="text-right font-serif text-ink-muted">{doc.location}</span></div>}
            {doc.pages && <div class="flex items-baseline justify-between gap-4 text-sm"><span class="font-mono text-[12px] tracking-[0.1em] uppercase text-rule">Length</span><span class="text-right font-serif text-ink-muted">{doc.pages}</span></div>}
            <div class="flex items-baseline justify-between gap-4 text-sm"><span class="font-mono text-[12px] tracking-[0.1em] uppercase text-rule">Format</span><span class="text-right font-serif text-ink-muted">{doc.file_type}</span></div>
          </div>
          {doc.excerpt && <p class="mb-5 text-pretty font-serif text-base leading-relaxed text-ink-muted">{doc.excerpt}</p>}
          {doc.tags && doc.tags.length > 0 && <div class="flex flex-wrap gap-1.5">{doc.tags.map((tag: string) => <span class="border border-rule px-1.5 py-0.5 font-mono text-[11px] tracking-[0.1em] uppercase text-rule">{tag}</span>)}</div>}
        </aside>
      )}

      <div class:list={[
        "flex flex-col overflow-hidden bg-card",
        isEssayReader
          ? "essay-shell shadow-[0_0_0_1px_rgba(28,35,64,0.06),0_1px_2px_-1px_rgba(28,35,64,0.08),0_18px_55px_rgba(28,35,64,0.07)]"
          : "min-h-[calc(100vh-220px)] border border-rule"
      ]}>
        <div class:list={[
          "relative flex items-center justify-between gap-4 border-b border-rule px-4 py-3 sm:px-5",
          isEssayReader ? "essay-toolbar sticky top-0 z-20 bg-parchment-dark/95 backdrop-blur" : "bg-parchment-dark"
        ]}>
          {(isSlideshow && slides.length) ? (
            <span class="font-mono text-[12px] tracking-[0.14em] uppercase text-ink-muted">Slide <span id="slide-counter" class="tabular-nums">1</span> of {slides.length}</span>
          ) : isEssayReader ? (
            <span class="font-mono text-[11px] tracking-[0.15em] uppercase text-ink-muted"><span id="reading-progress-label" class="tabular-nums">0%</span> read</span>
          ) : (
            <span class="font-mono text-[12px] tracking-[0.14em] uppercase text-rule">Document Preview</span>
          )}
          {isEssayReader ? (
            <div class="flex items-center gap-1.5">
              <span class="mr-1 hidden font-mono text-[10px] tracking-[0.12em] uppercase text-rule sm:inline">Text size</span>
              <button id="zoom-out" class="reader-control" aria-label="Decrease text size">A−</button>
              <span id="zoom-level" class="min-w-[2.7rem] text-center font-mono text-[10px] tracking-[0.08em] text-ink-muted tabular-nums">100%</span>
              <button id="zoom-in" class="reader-control" aria-label="Increase text size">A+</button>
              <button id="zoom-fit" class="reader-reset">Reset</button>
            </div>
          ) : (
            <div class="font-mono text-[12px] tracking-[0.14em] uppercase text-rule">{doc.file_type} Document</div>
          )}
          {isEssayReader && <div id="reading-progress" class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-stamp"></div>}
        </div>

        <div class:list={["flex-1", isEssayReader ? "bg-card" : "bg-parchment-dark/40"]}>
          {(isSlideshow && slides.length) ? (
            <div id="slideshow" data-slides={JSON.stringify(slides)} class="flex h-full flex-col">
              <div class="relative flex flex-1 items-center justify-center bg-ink/90">
                <img id="slide-image" src={slides[0]} alt={`${doc.title} — slide 1`} class="max-h-[72vh] w-full object-contain outline outline-1 -outline-offset-1 outline-black/10" />
                <button id="slide-prev" aria-label="Previous slide" class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-rule bg-parchment/90 font-mono text-2xl leading-none text-ink transition-[border-color,color,scale] duration-150 hover:border-stamp hover:text-stamp active:scale-[0.96]">&lsaquo;</button>
                <button id="slide-next" aria-label="Next slide" class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-rule bg-parchment/90 font-mono text-2xl leading-none text-ink transition-[border-color,color,scale] duration-150 hover:border-stamp hover:text-stamp active:scale-[0.96]">&rsaquo;</button>
              </div>
              <div id="slide-rail" class="flex gap-2 overflow-x-auto border-t border-rule bg-parchment-dark p-3">
                {slides.map((src, i) => <button class="slide-thumb shrink-0 border border-rule p-0.5 transition-[border-color,scale] duration-150 hover:border-stamp active:scale-[0.96]" data-index={i} aria-label={`Go to slide ${i + 1}`}><img src={src} loading="lazy" alt="" class="block h-14 w-auto outline outline-1 -outline-offset-1 outline-black/10" /></button>)}
              </div>
            </div>
          ) : isEssayReader ? (
            <>
              <article id="doc-prose" class="doc-prose mx-auto max-w-[70ch] px-7 py-12 sm:px-12 sm:py-16 lg:px-16 lg:py-20" set:html={proseHtml} />
              <footer id="essay-continuity" class="border-t border-rule bg-parchment-dark/35 px-7 py-12 sm:px-12 sm:py-14">
                <div class="mx-auto max-w-4xl">
                  <div class="text-center">
                    <div class="mx-auto mb-6 flex items-center justify-center gap-3" aria-hidden="true"><span class="h-px w-10 bg-rule"></span><span class="font-display text-stamp">◆</span><span class="h-px w-10 bg-rule"></span></div>
                    <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-rule">End of essay</p>
                    <h2 class="mt-3 text-balance font-display text-3xl text-ink">Continue Reading</h2>
                    <p class="mx-auto mt-2 max-w-xl text-pretty font-serif text-sm leading-relaxed text-ink-muted">Move through the archive in order, or follow one of the themes connected to this essay.</p>
                  </div>

                  {(previousEssay || nextEssay) && (
                    <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Previous and next essays">
                      {previousEssay ? (
                        <a href={`/docs/${previousEssay.slug}`} class="continuity-card group flex min-h-[150px] flex-col bg-card p-5 text-left transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 active:scale-[0.96]">
                          <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-stamp">← Previous essay</span>
                          <span class="mt-5 text-balance font-display text-xl leading-snug text-ink transition-colors duration-150 group-hover:text-stamp">{previousEssay.title}</span>
                          <span class="mt-auto pt-4 font-mono text-[10px] tracking-[0.11em] uppercase text-rule">{previousEssay.pages}</span>
                        </a>
                      ) : <span aria-hidden="true"></span>}
                      {nextEssay && (
                        <a href={`/docs/${nextEssay.slug}`} class="continuity-card group flex min-h-[150px] flex-col bg-card p-5 text-left transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 active:scale-[0.96] sm:text-right">
                          <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-stamp">Next essay →</span>
                          <span class="mt-5 text-balance font-display text-xl leading-snug text-ink transition-colors duration-150 group-hover:text-stamp">{nextEssay.title}</span>
                          <span class="mt-auto pt-4 font-mono text-[10px] tracking-[0.11em] uppercase text-rule">{nextEssay.pages}</span>
                        </a>
                      )}
                    </nav>
                  )}

                  {relatedEssays.length > 0 && (
                    <section class="mt-10 border-t border-rule pt-8" aria-labelledby="related-essays-title">
                      <div class="mb-5 flex flex-col justify-between gap-1 sm:flex-row sm:items-end">
                        <h3 id="related-essays-title" class="font-display text-2xl text-ink">You may also enjoy</h3>
                        <p class="font-mono text-[10px] tracking-[0.12em] uppercase text-rule">Related by topic</p>
                      </div>
                      <div class="grid gap-3 md:grid-cols-3">
                        {relatedEssays.map((essay) => {
                          const collection = essayCollections.find((item) => essay.editorial.collections.includes(item.id));
                          return (
                            <a href={`/docs/${essay.slug}`} class="continuity-card group flex min-h-[190px] flex-col bg-card p-5 text-left transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 active:scale-[0.96]">
                              <span class="font-mono text-[10px] tracking-[0.13em] uppercase text-stamp">{collection?.label || 'From the archive'}</span>
                              <span class="mt-5 text-balance font-display text-xl leading-snug text-ink transition-colors duration-150 group-hover:text-stamp">{essay.title}</span>
                              <span class="mt-3 line-clamp-3 text-pretty font-serif text-sm leading-relaxed text-ink-muted">{essay.editorial.deck || cleanExcerpt(essay.excerpt, essay.title)}</span>
                              <span class="mt-auto pt-5 font-mono text-[10px] tracking-[0.11em] uppercase text-rule">Read next →</span>
                            </a>
                          );
                        })}
                      </div>
                    </section>
                  )}

                  <div class="mt-9 text-center"><a href="/essays" class="inline-flex min-h-11 items-center border border-rule px-4 py-2 font-mono text-[11px] tracking-[0.12em] uppercase text-ink transition-[border-color,color,scale] duration-150 hover:border-stamp hover:text-stamp active:scale-[0.96]">Return to all essays</a></div>
                </div>
              </footer>
            </>
          ) : (hasFile && isImage) ? (
            <div class="flex items-center justify-center bg-ink/90 p-4"><img src={fileUrl} alt={doc.title} class="max-h-[80vh] w-full object-contain outline outline-1 -outline-offset-1 outline-black/10" /></div>
          ) : (hasFile && isPdf) ? (
            <iframe id="pdf-frame" src={fileUrl} class="h-[80vh] w-full border-0" title={doc.title} />
          ) : hasFile ? (
            <div class="flex min-h-[60vh] items-center justify-center p-10"><div class="max-w-sm text-center"><p class="mb-3 font-mono text-[12px] tracking-[0.16em] uppercase text-stamp">{doc.file_type} File</p><h3 class="mb-3 font-display text-2xl text-ink">Available to Download</h3><p class="mb-6 text-pretty font-serif leading-relaxed text-ink-muted">This {doc.file_type} document can&rsquo;t be previewed in the browser. Download it to read the original.</p><a href={downloadUrl} download class="inline-flex min-h-11 items-center gap-2 border border-stamp bg-stamp px-5 py-3 font-mono text-[13px] tracking-[0.12em] uppercase text-card transition-[background-color,scale] duration-150 hover:bg-stamp-hover active:scale-[0.96]">Download {downloadType}</a></div></div>
          ) : (
            <div class="flex min-h-[60vh] items-center justify-center p-10"><div class="max-w-md text-center"><p class="mb-3 font-mono text-[12px] tracking-[0.16em] uppercase text-stamp">Not Yet Available</p><h3 class="mb-3 font-display text-2xl text-ink">Document Coming Soon</h3><p class="text-pretty font-serif leading-relaxed text-ink-muted">The file for this {doc.file_type} document hasn&rsquo;t been added to the archive yet. Please check back later.</p></div></div>
          )}
        </div>
      </div>
    </div>
  </div>

  <style>
    .continuity-card {
      box-shadow:
        0 0 0 1px rgba(28, 35, 64, 0.07),
        0 1px 2px -1px rgba(28, 35, 64, 0.07),
        0 8px 22px rgba(28, 35, 64, 0.04);
    }
    .continuity-card:hover {
      box-shadow:
        0 0 0 1px rgba(139, 31, 31, 0.2),
        0 2px 4px -1px rgba(28, 35, 64, 0.09),
        0 12px 28px rgba(28, 35, 64, 0.07);
    }
    .reader-control,
    .reader-reset {
      min-width: 40px;
      min-height: 40px;
      border: 1px solid var(--color-rule);
      background: var(--color-card);
      color: var(--color-ink);
      font-family: var(--font-mono);
      transition-property: color, border-color, scale;
      transition-duration: 150ms;
    }
    .reader-control:hover,
    .reader-reset:hover {
      border-color: var(--color-stamp);
      color: var(--color-stamp);
    }
    .reader-control:active,
    .reader-reset:active {
      scale: 0.96;
    }
    .reader-reset {
      padding: 0 0.65rem;
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .doc-prose {
      font-family: var(--font-serif);
      color: var(--color-ink);
      font-size: var(--prose-size, 1.125rem);
      line-height: 1.85;
      overflow-wrap: anywhere;
    }
    .doc-prose :global(p) {
      margin: 0 0 1.45em;
    }
    .doc-prose :global(p:empty),
    .doc-prose :global(p > br:only-child) {
      margin: 0;
    }
    .doc-prose :global(h1),
    .doc-prose :global(h2),
    .doc-prose :global(h3),
    .doc-prose :global(h4) {
      margin: 2.25em 0 0.75em;
      font-family: var(--font-display);
      font-weight: 400;
      line-height: 1.3;
      text-wrap: balance;
    }
    .doc-prose :global(h1) { font-size: 1.8em; }
    .doc-prose :global(h2) { font-size: 1.5em; }
    .doc-prose :global(h3),
    .doc-prose :global(h4) { font-size: 1.2em; }
    .doc-prose :global(b),
    .doc-prose :global(strong) {
      color: var(--color-ink);
      font-weight: 700;
    }
    .doc-prose :global(i),
    .doc-prose :global(em) {
      font-style: italic;
    }
    .doc-prose :global(sup) {
      font-size: 0.7em;
    }
    .doc-prose :global(a) {
      color: var(--color-stamp);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .doc-prose :global(ul),
    .doc-prose :global(ol) {
      margin: 0 0 1.5em 1.3em;
    }
    .doc-prose :global(li) {
      margin-bottom: 0.5em;
      padding-left: 0.35em;
    }
    .doc-prose :global(blockquote) {
      margin: 2em 0;
      border-left: 3px solid var(--color-stamp);
      padding: 0.5em 0 0.5em 1.4em;
      color: var(--color-ink-muted);
      font-style: italic;
    }
    .doc-prose :global(hr) {
      margin: 2.5em auto;
      width: 4rem;
      border: 0;
      border-top: 1px solid var(--color-rule);
    }
    .doc-prose :global(img) {
      max-width: 100%;
      height: auto;
      margin: 2rem auto;
      display: block;
      outline: 1px solid rgba(0, 0, 0, 0.1);
      outline-offset: -1px;
      box-shadow: 0 12px 34px rgba(28, 35, 64, 0.08);
    }
    .doc-prose :global(table) {
      display: block;
      width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      margin: 2rem 0;
      font-size: 0.9em;
    }
    .doc-prose :global(td),
    .doc-prose :global(th) {
      border: 1px solid var(--color-rule);
      padding: 0.5rem 0.75rem;
      text-align: left;
    }
    @media (max-width: 640px) {
      .essay-toolbar {
        margin-inline: -1px;
      }
      .reader-reset {
        display: none;
      }
      .doc-prose {
        line-height: 1.78;
      }
    }
  </style>

  <script>
    // Text-size zoom for HTML prose (A-/A+/Reset).
    let zoomLevel = 100;
    try {
      const savedZoom = Number(window.localStorage.getItem('essay-text-size'));
      if (savedZoom >= 80 && savedZoom <= 160) zoomLevel = savedZoom;
    } catch {
      // Reading preferences are optional when storage is unavailable.
    }
    const baseRem = 1.125;
    const zoomDisplay = document.getElementById('zoom-level');
    const prose = document.getElementById('doc-prose');
    const progressBar = document.getElementById('reading-progress');
    const progressLabel = document.getElementById('reading-progress-label');

    function applyZoom() {
      if (zoomDisplay) zoomDisplay.textContent = `${zoomLevel}%`;
      if (prose) prose.style.setProperty('--prose-size', `${(baseRem * zoomLevel) / 100}rem`);
      try {
        window.localStorage.setItem('essay-text-size', String(zoomLevel));
      } catch {
        // Reading preferences are optional when storage is unavailable.
      }
      updateReadingProgress();
    }

    function updateReadingProgress() {
      if (!prose || !progressBar || !progressLabel) return;
      const start = prose.getBoundingClientRect().top + window.scrollY - 120;
      const distance = Math.max(1, prose.offsetHeight - window.innerHeight * 0.55);
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      const percentage = Math.round(progress * 100);
      progressBar.style.transform = `scaleX(${progress})`;
      progressLabel.textContent = `${percentage}%`;
    }

    document.getElementById('zoom-in')?.addEventListener('click', () => {
      zoomLevel = Math.min(180, zoomLevel + 10);
      applyZoom();
    });
    document.getElementById('zoom-out')?.addEventListener('click', () => {
      zoomLevel = Math.max(70, zoomLevel - 10);
      applyZoom();
    });
    document.getElementById('zoom-fit')?.addEventListener('click', () => {
      zoomLevel = 100;
      applyZoom();
    });
    applyZoom();

    let progressFrame = 0;
    const requestProgressUpdate = () => {
      if (progressFrame) return;
      progressFrame = window.requestAnimationFrame(() => {
        updateReadingProgress();
        progressFrame = 0;
      });
    };
    window.addEventListener('scroll', requestProgressUpdate, { passive: true });
    window.addEventListener('resize', requestProgressUpdate);

    // Slideshow gallery navigation.
    const slideshow = document.getElementById('slideshow');
    if (slideshow) {
      const slides: string[] = JSON.parse(slideshow.dataset.slides || '[]');
      const slideImage = document.getElementById('slide-image') as HTMLImageElement | null;
      const slideCounter = document.getElementById('slide-counter');
      const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.slide-thumb'));
      let slideIndex = 0;

      const showSlide = (n: number) => {
        if (slides.length === 0) return;
        slideIndex = (n + slides.length) % slides.length;
        if (slideImage) slideImage.src = slides[slideIndex];
        if (slideCounter) slideCounter.textContent = String(slideIndex + 1);
        thumbs.forEach((thumb, i) => {
          thumb.classList.toggle('border-stamp', i === slideIndex);
          thumb.classList.toggle('border-rule', i !== slideIndex);
        });
        thumbs[slideIndex]?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      };

      document.getElementById('slide-prev')?.addEventListener('click', () => showSlide(slideIndex - 1));
      document.getElementById('slide-next')?.addEventListener('click', () => showSlide(slideIndex + 1));
      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => showSlide(i)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') showSlide(slideIndex - 1);
        else if (e.key === 'ArrowRight') showSlide(slideIndex + 1);
      });
      showSlide(0);
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.location.href = prose ? '/essays' : '/';
      } else if (prose && (e.key === '+' || e.key === '=')) {
        e.preventDefault();
        zoomLevel = Math.min(180, zoomLevel + 10);
        applyZoom();
      } else if (prose && e.key === '-') {
        e.preventDefault();
        zoomLevel = Math.max(70, zoomLevel - 10);
        applyZoom();
      } else if (prose && e.key === '0') {
        e.preventDefault();
        zoomLevel = 100;
        applyZoom();
      }
    });
  </script>
</MainLayout>
