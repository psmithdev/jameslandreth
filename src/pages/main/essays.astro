---
import MainLayout from '../../layouts/MainLayout.astro';
import { createServerClient } from '../../lib/supabase';

const supabase = createServerClient();
const { data, error } = await supabase
  .from('documents')
  .select('slug,title,excerpt,date,year,location,tags,pages,file_type,featured')
  .eq('status', 'published')
  .eq('category', 'Essay');

const essays = (data || []).sort((a, b) => {
  const yearDifference = (b.year || 0) - (a.year || 0);
  return yearDifference || a.title.localeCompare(b.title);
});
const onlineCount = essays.filter((essay) => /html/i.test(essay.file_type || '')).length;
const topicCount = new Set(essays.flatMap((essay) => essay.tags || [])).size;

function cleanExcerpt(value: string | null, title: string): string {
  if (!value) return '';
  const escapedTitle = title
    .trim()
    .split(/\s+/)
    .map((word: string) => word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    .join('\\s+');
  return value
    .trim()
    .replace(new RegExp(`^${escapedTitle}\\s*[:—–-]?\\s*`, 'i'), '')
    .replace(/^INTRO\b\s*[:—–-]?\s*/i, '')
    .trim();
}
---

<MainLayout title="Essays & Reflections - Dr. James Landreth">
  <div class="mx-auto max-w-6xl px-6 py-10 sm:py-14">
    <nav class="mb-9 flex items-center gap-2 font-mono text-[12px] tracking-[0.14em] uppercase text-rule" aria-label="Breadcrumb">
      <a href="/" class="transition-colors duration-150 hover:text-stamp">Archive</a>
      <span aria-hidden="true">/</span>
      <span class="text-stamp">Essays</span>
    </nav>

    <header class="grid gap-8 border-b border-rule pb-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div class="max-w-3xl">
        <p class="mb-3 font-mono text-[12px] tracking-[0.2em] uppercase text-stamp">The Reading Room</p>
        <h1 class="text-balance font-display text-4xl leading-tight text-ink sm:text-5xl">Essays &amp; Reflections</h1>
        <p class="mt-5 max-w-2xl text-pretty font-serif text-lg leading-relaxed text-ink-muted">
          Stories of family, travel, medicine, history, and the small observations gathered over a lifetime.
          Read the essays here, or download the preserved originals.
        </p>
      </div>
      <dl class="grid grid-cols-3 gap-6 lg:min-w-[360px]">
        <div class="border-l border-rule pl-4">
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-rule">Essays</dt>
          <dd class="mt-1 font-display text-3xl text-ink">{essays.length}</dd>
        </div>
        <div class="border-l border-rule pl-4">
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-rule">Online</dt>
          <dd class="mt-1 font-display text-3xl text-ink">{onlineCount}</dd>
        </div>
        <div class="border-l border-rule pl-4">
          <dt class="font-mono text-[11px] tracking-[0.14em] uppercase text-rule">Topics</dt>
          <dd class="mt-1 font-display text-3xl text-ink">{topicCount}</dd>
        </div>
      </dl>
    </header>

    {error ? (
      <section class="mt-10 bg-card p-8 text-center shadow-[0_0_0_1px_rgba(28,35,64,0.06)]">
        <p class="font-serif text-ink-muted">The essays could not be loaded. Please try again shortly.</p>
      </section>
    ) : (
      <>
        <section class="mt-8 flex flex-col gap-4 bg-parchment-dark/60 p-4 shadow-[0_0_0_1px_rgba(28,35,64,0.06)] sm:flex-row sm:items-center sm:justify-between sm:p-5" aria-label="Essay filters">
          <label class="relative block min-w-0 flex-1 sm:max-w-xl">
            <span class="sr-only">Search essays</span>
            <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-rule" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" /></svg>
            <input
              id="essay-search"
              type="search"
              placeholder="Search titles, stories, and topics…"
              class="h-12 w-full border border-rule bg-card pl-11 pr-4 font-serif text-base text-ink outline-none transition-colors duration-150 placeholder:text-rule focus:border-stamp"
            />
          </label>
          <div id="essay-format-filters" class="flex flex-wrap gap-2">
            <button type="button" class="essay-filter is-active" data-format="all">All</button>
            <button type="button" class="essay-filter" data-format="html">Read online</button>
            <button type="button" class="essay-filter" data-format="file">Original files</button>
          </div>
        </section>

        <section class="mt-8" aria-labelledby="essay-list-title">
          <div class="mb-5 flex items-center justify-between gap-4">
            <h2 id="essay-list-title" class="font-mono text-[12px] tracking-[0.18em] uppercase text-ink-muted">All Essays</h2>
            <p id="essay-result-count" class="font-mono text-[12px] tracking-[0.12em] uppercase text-rule tabular-nums">{essays.length} titles</p>
          </div>

          <div id="essay-grid" class="grid gap-4 md:grid-cols-2">
            {essays.map((essay) => {
              const format = /html/i.test(essay.file_type || '') ? 'html' : 'file';
              const displayExcerpt = cleanExcerpt(essay.excerpt, essay.title);
              const searchable = [essay.title, displayExcerpt, ...(essay.tags || [])].filter(Boolean).join(' ').toLowerCase();
              return (
                <article class="essay-card group relative bg-card shadow-[0_0_0_1px_rgba(28,35,64,0.07),0_1px_2px_-1px_rgba(28,35,64,0.08),0_8px_24px_rgba(28,35,64,0.035)] transition-[box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:shadow-[0_0_0_1px_rgba(139,31,31,0.22),0_2px_4px_-1px_rgba(28,35,64,0.10),0_14px_32px_rgba(28,35,64,0.07)]" data-format={format} data-search={searchable}>
                  <a href={`/docs/${essay.slug}`} class="flex h-full min-h-[250px] flex-col p-6 active:scale-[0.96] transition-transform duration-150">
                    <div class="mb-5 flex items-center justify-between gap-4">
                      <span class="font-mono text-[11px] tracking-[0.15em] uppercase text-stamp">
                        {format === 'html' ? 'Read online' : essay.file_type}
                      </span>
                      <span class="font-mono text-[11px] tracking-[0.12em] uppercase text-rule">{essay.pages}</span>
                    </div>
                    <h3 class="text-balance font-display text-2xl leading-snug text-ink transition-colors duration-150 group-hover:text-stamp">{essay.title}</h3>
                    {displayExcerpt && (
                      <p class="mt-3 line-clamp-3 text-pretty font-serif text-[0.95rem] leading-relaxed text-ink-muted">{displayExcerpt}</p>
                    )}
                    <div class="mt-auto flex items-end justify-between gap-5 pt-6">
                      <div>
                        {(essay.date || essay.location) && (
                          <p class="mb-2 font-mono text-[11px] tracking-[0.1em] uppercase text-rule">
                            {[essay.date, essay.location].filter(Boolean).join(' · ')}
                          </p>
                        )}
                        {essay.tags?.length > 0 && (
                          <div class="flex flex-wrap gap-x-3 gap-y-1">
                            {essay.tags.slice(0, 3).map((tag: string) => (
                              <span class="font-mono text-[10px] tracking-[0.11em] uppercase text-rule">{tag}</span>
                            ))}
                          </div>
                        )}
                      </div>
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-parchment-dark font-mono text-lg text-ink transition-[background-color,color,transform] duration-150 group-hover:translate-x-0.5 group-hover:bg-stamp group-hover:text-card" aria-hidden="true">→</span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>

          <div id="essay-empty" class="mt-8 hidden bg-card px-6 py-14 text-center shadow-[0_0_0_1px_rgba(28,35,64,0.06)]">
            <p class="font-display text-2xl text-ink">No essays found</p>
            <p class="mt-2 font-serif text-ink-muted">Try a different word or show all formats.</p>
          </div>
        </section>
      </>
    )}
  </div>

  <style>
    .essay-filter {
      min-height: 44px;
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--color-rule);
      background: var(--color-card);
      color: var(--color-ink-muted);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transition-property: color, background-color, border-color, scale;
      transition-duration: 150ms;
    }
    .essay-filter:hover,
    .essay-filter.is-active {
      border-color: var(--color-stamp);
      background: var(--color-stamp);
      color: var(--color-card);
    }
    .essay-filter:active {
      scale: 0.96;
    }
  </style>

  <script>
    const search = document.getElementById('essay-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.essay-card'));
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.essay-filter'));
    const count = document.getElementById('essay-result-count');
    const empty = document.getElementById('essay-empty');
    let activeFormat = 'all';

    function applyFilters() {
      const query = search?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => {
        const matchesText = !query || (card.dataset.search || '').includes(query);
        const matchesFormat = activeFormat === 'all' || card.dataset.format === activeFormat;
        const show = matchesText && matchesFormat;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'title' : 'titles'}`;
      empty?.classList.toggle('hidden', visible !== 0);
    }

    search?.addEventListener('input', applyFilters);
    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        activeFormat = filter.dataset.format || 'all';
        filters.forEach((item) => item.classList.toggle('is-active', item === filter));
        applyFilters();
      });
    });
  </script>
</MainLayout>
